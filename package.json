{
  "name": "basira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "analyzer:ai": "tsx services/ai-analyzer/src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d --build",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.dev.yml down"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.39",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@better-auth/prisma-adapter": "^1.6.26",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.58",
    "better-auth": "^1.6.26",
    "bullmq": "^6.0.9",
    "ioredis": "^6.0.0",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "perfect-freehand": "^1.2.3",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
